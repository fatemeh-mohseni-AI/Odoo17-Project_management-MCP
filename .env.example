# Odoo connection. In the MCP Docker container, use the Odoo service/container name.
ODOO_URL=http://odoo:8069
ODOO_DB=company
ODOO_USERNAME=ai-project-service@example.com
ODOO_API_KEY=replace-with-an-odoo-api-key
# ODOO_PASSWORD=use-only-when-an-api-key-is-not-available

# Mandatory project boundary (comma-separated database IDs).
ODOO_ALLOWED_PROJECT_IDS=12,34

# Optional: restrict who the AI may assign. Empty means any active internal user
# visible to the Odoo service account.
ODOO_ALLOWED_ASSIGNEE_USER_IDS=7,19

# MCP server. Streamable HTTP is the primary/default transport.
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=31080
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-at-least-32-random-characters
# Host interface on which Docker publishes MCP_PORT. Use 127.0.0.1 behind a reverse proxy.
MCP_PUBLISH_HOST=0.0.0.0

# Mutating feature gates.
ODOO_ALLOW_PROJECT_CREATION=false
ODOO_PERSIST_CREATED_PROJECTS=true
ODOO_STATE_FILE=/data/state.json
ODOO_ENABLE_HARD_DELETE=false

# Network and logging.
ODOO_VERIFY_TLS=true
ODOO_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
